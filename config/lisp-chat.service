[Unit]
Description=LISP browser and IRC chat
After=network.target
[Service]
User=lanserver
Group=lanserver
WorkingDirectory=/opt/lan-portal
ExecStart=/usr/bin/python3 -u /opt/lan-portal/chat_server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/lan-party/chat
MemoryMax=160M
TasksMax=192
LimitNOFILE=512
[Install]
WantedBy=multi-user.target
