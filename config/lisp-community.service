[Unit]
Description=LISP tournament voting, forum synchronization and trophies
After=lisp-accounts.service lisp-bracket.service lisp-forum.service
[Service]
User=lancommunity
Group=lispcommunity
SupplementaryGroups=lanserver
WorkingDirectory=/opt/lan-portal
ExecStart=/usr/bin/python3 -u /opt/lan-portal/community_server.py
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lisp-community
MemoryMax=256M
TasksMax=64
[Install]
WantedBy=multi-user.target
